# Copy to .env and fill in. Never commit .env.
# All values below are placeholders.

# --- Server ---
PORT=3000
# Number of reverse proxies in front of the app (e.g. 1 on Cloud Run). Leave
# empty when clients connect directly; rate limits key on the client address.
TRUST_PROXY=
# Requests per client per window (src/config/http.js). Defaults: 15 minutes,
# 300 for the whole app, 30 for /calendar and /calendar/export.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_CALENDAR_MAX=30

# --- Database (src/config/env.js) ---
DATABASE_HOST=localhost
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_NAME=time4torah_db
# Read-only user for the API server (npm start). Jobs always use DATABASE_USER.
# Create it with db/readonly_user.sql. Left empty, the server uses
# DATABASE_USER and logs a warning. HOST and NAME default to the values above.
DATABASE_READ_USER=
DATABASE_READ_PASSWORD=
DATABASE_READ_HOST=
DATABASE_READ_NAME=

# --- Seeding / schedule generation (db/*) ---
DATE_START=2025-05-01
DATE_END=2025-06-01
SCHEDULE_START=2025-05-01
MISHNA_START_ID=1
NACH_SCHEDULE_START=2025-05-01
NACH_START_ID=1

# --- Files and calendar export ---
BUCKET_PATH=/path/to/shiurim/bucket
CHROME_BIN=/usr/bin/google-chrome
CALENDAR_EXPORT_HOST=http://127.0.0.1

# --- Daily send (src/config/send.js) ---
# dry-run (default) writes to the console and OUTBOX_DIR only.
# live sends email via Mailchimp (see below); WhatsApp is still a stub.
# For the live Mailchimp send use SEND_CHANNELS=email and SEND_PROGRAMS=time4mishna.
SEND_MODE=dry-run
# Comma-separated: email, whatsapp
SEND_CHANNELS=email,whatsapp
# Comma-separated: time4mishna, time4nach, combined
SEND_PROGRAMS=time4mishna,time4nach
# Dry-run output folder (gitignored)
OUTBOX_DIR=outbox

# --- Admin API token (GET /calendar/export) ---
# Bearer token for the admin-only calendar export route. Use a long random
# value, e.g. `openssl rand -hex 32`. Left empty, the route returns 503.
SENDS_ADMIN_TOKEN=

# --- Daily email (src/config/email.js) ---
# BUCKET_PATH (above) must be the bucket's public URL: SHIUR/TEXT links are
# <BUCKET_PATH>/mishna/shiurim/<title>.mp3 and <BUCKET_PATH>/mishna/texts/<title>.pdf.
# A live send refuses to run without it.
# Email images (logo). Default: <BUCKET_PATH>/email — upload imgs/Time-4-Mishnah-logo_black_NEW.png
# and imgs/Time-4-Torah-logo_NEW.png there.
EMAIL_ASSETS_URL=
# Provider's unsubscribe link or merge tag; the footer link is omitted while empty.
# Mailchimp: *|UNSUB|* (required for a Mailchimp send).
EMAIL_UNSUBSCRIBE_URL=

# --- Mailchimp (src/config/mailchimp.js) ---
# Required for a live email send. In dry-run, setting any MAILCHIMP_* variable
# makes the job validate them and write the campaign payload to OUTBOX_DIR.
# API key, ending in the server prefix (e.g. -us21).
MAILCHIMP_API_KEY=
# Optional when the key ends in -<prefix>.
MAILCHIMP_SERVER_PREFIX=
# Audience (list) ID. Mailchimp only delivers to subscribed members.
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_FROM_NAME=
MAILCHIMP_REPLY_TO=
# Send time, on the quarter hour, in SEND_TIMEZONE. Defaults: 05:15, Europe/London.
SEND_TIME=
SEND_TIMEZONE=

# Castos (podcast episodes, which Castos's RSS feed sends on to Spotify).
# CASTOS_PODCAST_ID is the TEST show: the default target, and the only one the
# integration script uses. The live Time4Mishna show is only used with
# `npm run castos:publish -- --podcast=live`.
CASTOS_API_KEY=
CASTOS_PODCAST_ID=
CASTOS_LIVE_PODCAST_ID=
# Episodes are scheduled for this time (HH:MM, in SEND_TIMEZONE). Default 05:15.
CASTOS_PUBLISH_TIME=

# In-app scheduler (src/services/scheduler), started by `npm start`. Off unless
# SCHEDULER_ENABLED=true; turn it on in ONE running copy only. SEND_MODE still
# decides live vs dry-run. Live with Castos on also needs CASTOS_LIVE_PODCAST_ID.
# Evening run: email for tomorrow + Castos for the next SCHEDULER_CASTOS_DAYS days.
# Morning run: email + Castos for today (catch-up). Times are HH:MM in SEND_TIMEZONE.
SCHEDULER_ENABLED=false
SCHEDULER_EVENING_TIME=21:00
SCHEDULER_MORNING_TIME=04:30
SCHEDULER_CASTOS=true
SCHEDULER_CASTOS_DAYS=7
