{
  "name": "time4torah-app",
  "version": "1.0.0",
  "description": "App to code all time4torah programs",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node ./src/server.js",
    "dev": "node --watch ./src/server.js",
    "test": "NODE_OPTIONS=--localstorage-file=/tmp/jest-localstorage jest --watch",
    "seed": "node ./db/seed.js",
    "test:ci": "NODE_OPTIONS=--localstorage-file=/tmp/jest-localstorage jest --testPathIgnorePatterns=/__tests__/integration/",
    "test:integration": "NODE_OPTIONS=--localstorage-file=/tmp/jest-localstorage jest __tests__/integration",
    "send:daily": "node ./jobs/dailySend.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shalommoise/t4torah-app.git"
  },
  "keywords": [
    "torah",
    "Judaism"
  ],
  "author": "Shalom Moise",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/shalommoise/t4torah-app/issues"
  },
  "homepage": "https://github.com/shalommoise/t4torah-app#readme",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "mysql": "^2.18.1",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.0.0"
  }
}
